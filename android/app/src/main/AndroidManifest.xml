<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <!-- INTERNET intentionally omitted: this app is fully offline. Capacitor
         serves www/ to the WebView via an in-process request interceptor
         (androidScheme "https"), not a real network socket, so no INTERNET
         permission should be required to load the app's own UI. This is
         unverified on a real device as of this commit - see NOTES.md. If
         the app fails to load (blank screen) on first real-device test,
         restoring this permission is the first thing to try. -->

    <!-- Bluetooth LE (Android 12+ / API 31+). The bluetooth-le plugin's own
         manifest already contributes BLUETOOTH_SCAN/BLUETOOTH_CONNECT plus
         legacy BLUETOOTH/BLUETOOTH_ADMIN/ACCESS_FINE_LOCATION (maxSdk 30) via
         manifest merging; this override adds usesPermissionFlags="neverForLocation"
         to BLUETOOTH_SCAN since the app only ever connects to named printers
         (M110) and never derives physical location from scan results. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"
        tools:node="replace" />
</manifest>
